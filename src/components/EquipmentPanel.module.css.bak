.tab {
  display: grid;
  grid-template-areas:
    '.      head   .'
    'cape   neck   ammo'
    'weapon body   shield'
    '.      legs   .'
    'hands  feet   ring';
  gap: 6px;
  justify-content: center;
  padding: 14px 10px;
  /* sunken well behind the slots so occupied items pop out of it */
  background: radial-gradient(ellipse at 50% 38%, rgba(0, 0, 0, 0.38), rgba(0, 0, 0, 0.08) 75%);
  border: 1px solid var(--border-dark);
  border-radius: 6px;
  box-shadow: inset 0 2px 12px rgba(0, 0, 0, 0.55);
}

.slot {
  position: relative;
  width: 72px;
  height: 72px;
  background-color: var(--tile);
  background-size: cover;
  border: 2px solid transparent;
  border-radius: 3px;
  cursor: pointer;
  /* flex centering (not grid) so it can't fight RsTooltip's inline-flex wrap */
  align-items: center;
  justify-content: center;
  /* recessed tile: the slot sinks, the item rises */
  box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.55), 0 1px 0 rgba(255, 255, 255, 0.04);
}

.slot:hover {
  filter: brightness(1.2);
}

.icon {
  max-width: 60px;
  max-height: 60px;
  /* icons are ~36px sprites; scale up crisp */
  width: auto;
  height: auto;
  transform: scale(1.7);
  filter: drop-shadow(0 4px 5px rgba(0, 0, 0, 0.85)) drop-shadow(0 0 8px rgba(0, 0, 0, 0.45));
  transition: transform 90ms ease-out;
  pointer-events: none;
}

.slot:hover .icon {
  transform: scale(1.85) translateY(-1px);
}

.locked {
  /* lock reads as a green glow + badge; the BORDER belongs to the rarity tier */
  box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.55), 0 0 10px var(--green-glow),
    0 0 0 1px var(--green);
}

/* only filled slots are clickable (lock toggles) */
.slot {
  cursor: default;
}

.lockable,
.locked {
  cursor: pointer;
}

.lockBadge {
  position: absolute;
  bottom: 1px;
  right: 2px;
  font-size: 11px;
  pointer-events: none;
  filter: drop-shadow(0 0 2px black);
}

/* rarity tier borders — the slot frame takes the tier colour of its item */
.junk {
  border-color: var(--tier-junk);
}

.common {
  border-color: var(--tier-common);
}

.decent {
  border-color: var(--tier-decent);
}

.strong {
  border-color: var(--tier-strong);
}

.elite {
  border-color: var(--tier-elite);
  box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.55), 0 0 9px rgba(244, 208, 63, 0.45);
}
